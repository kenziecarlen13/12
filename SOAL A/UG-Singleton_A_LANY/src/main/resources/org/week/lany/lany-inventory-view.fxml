<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.week.lany.LanyInventoryController">
   <MenuBar>
     <menus>
       <Menu mnemonicParsing="false" text="Edit">
         <items>
           <MenuItem mnemonicParsing="false" text="Log Out" />
         </items>
       </Menu>
       <Menu mnemonicParsing="false" text="Help">
         <items>
           <MenuItem mnemonicParsing="false" onAction="#onActionMenuAbout" text="About" />
         </items>
       </Menu>
     </menus>
      <VBox.margin>
         <Insets />
      </VBox.margin>
   </MenuBar>
   <Label text="Ticket Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold;">
      <VBox.margin>
         <Insets bottom="10.0" top="10.0" />
      </VBox.margin>
   </Label>
   <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
      <rowConstraints>
        <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" />
         <ColumnConstraints />
      </columnConstraints>
      <children>
          <Label text="Section Name:" GridPane.rowIndex="0" />
          <Label text="Price:" GridPane.rowIndex="1" />
          <Label text="Stock:" GridPane.rowIndex="2" />
          <TextField fx:id="txtSectionName" promptText="Section Name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
          <TextField fx:id="txtPrice" promptText="Price (e.g. 500000.0)" GridPane.columnIndex="1" GridPane.rowIndex="1" />
          <TextField fx:id="txtStock" promptText="Stock (e.g. 50)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </GridPane>
   <HBox alignment="CENTER_RIGHT" prefHeight="19.0" prefWidth="200.0">
        <Button fx:id="btnSimpan" onAction="#onBtnSimpanClick" text="Simpan">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
        </Button>
        <Button fx:id="btnHapus" onAction="#onBtnHapus" text="Hapus">
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </Button>
        <Button fx:id="btnGrafik" onAction="#onBtnGrafik" text="Grafik">
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </Button>
   </HBox>
   <StackPane styleClass="highlight-rectangle">
     <TextField fx:id="searchBox" styleClass="transparent" />
     <Button mnemonicParsing="false" onAction="#handleClearSearchText" styleClass="delete-button" text="Bersihkan" StackPane.alignment="CENTER_RIGHT" />
      <padding>
         <Insets left="10.0" right="10.0" top="10.0" />
      </padding>
   </StackPane>
   <TableView fx:id="table" layoutY="163.2" prefHeight="250.0" prefWidth="452.0">
      <columns>
          <TableColumn fx:id="colId" maxWidth="1.7976931348623157E308" prefWidth="50.0" resizable="false" text="ID" />
          <TableColumn fx:id="colSectionName" maxWidth="1.7976931348623157E308" prefWidth="200.0" resizable="false" text="Section Name" />
          <TableColumn fx:id="colPrice" maxWidth="1.7976931348623157E308" prefWidth="120.0" resizable="false" text="Price" />
          <TableColumn fx:id="colStock" maxWidth="1.7976931348623157E308" prefWidth="80.0" resizable="false" text="Stock" />
      </columns>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" />
      </padding>
   </TableView>
</VBox>

